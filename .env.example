# Copiar a .env y ajustar. Nunca subir .env al repositorio.
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=inseguridad-airflow:3.1.8
AIRFLOW_WEB_PORT=8081
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
WAREHOUSE_PASSWORD=warehouse
AIRFLOW__API_AUTH__JWT_SECRET=cambiar_por_un_valor_aleatorio
# ECV_RAW_DIR solo si los CSV no estan en data/raw/ecv. No usar con Docker:
# Docker pasa este archivo al contenedor y alli la ruta de tu equipo no existe.
# ECV_RAW_DIR=
